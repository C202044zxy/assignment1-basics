{
  "train_data": "data/TinyStoriesV2-GPT4-train.txt",
  "val_data": "data/TinyStoriesV2-GPT4-valid.txt",
  "data_dtype": "uint16",
  "model_dtype": "float32",

  "batch_size": 64,
  "context_length": 128,
  "device": "auto",

  "vocab": "data/vocab.json",
  "merges": "data/merges.txt",
  "special_tokens": ["<|endoftext|>"],

  "vocab_size": 9999,
  "d_model": 512,
  "num_layers": 4,
  "num_heads": 16,
  "d_ff": 1344,
  "rope_theta": 10000.0,

  "lr": 3e-4,
  "weight_decay": 0.01,
  "beta1": 0.9,
  "beta2": 0.95,
  "eps": 1e-8,

  "resume": "",
  "ckpt_dir": "checkpoints",
  "max_iter": 10000,
  "lr_max": 3e-4,
  "lr_min": 3e-5,
  "warmup_iters": 1000,
  "cosine_iters": 9000,
  "grad_clip": 1.0,
  "eval_iter": 500,
  "eval_runs": 10,
  "ckpt_iter": 0
}


